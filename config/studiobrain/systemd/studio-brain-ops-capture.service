[Unit]
Description=Studio Brain privileged ops evidence capture
Documentation=https://github.com/monsoonfirepottery-byte/monsoonfire-portal/blob/main/docs/ops/22-privileged-evidence-capture.md
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/studio-brain-ops-capture

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/studio-brain-ops-capture
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/studio-brain/ops-evidence
