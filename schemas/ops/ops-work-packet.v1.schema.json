{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-brain.local/schemas/ops/ops-work-packet.v1.schema.json",
  "title": "Studio Brain Ops Work Packet",
  "type": "object",
  "required": ["schema", "generatedAt", "runId", "purpose", "sources", "constraints", "evidenceSummary", "freshEvidence", "sourceSignalAudit", "packets"],
  "properties": {
    "schema": { "const": "studiobrain-ops-work-packet.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string" },
    "purpose": { "type": "string" },
    "sources": {
      "type": "object",
      "required": ["riskRegister", "backlog", "effectivity", "adminAudit", "sliceLedger", "toolInventory", "toolInstallRecommendations", "toolingFindings", "swarmPreflight", "hostDriftManifest", "prStackAudit"],
      "properties": {
        "riskRegister": { "type": "string" },
        "backlog": { "type": "string" },
        "effectivity": { "type": "string" },
        "adminAudit": { "type": "string" },
        "sliceLedger": { "type": "string" },
        "toolInventory": { "type": "string" },
        "toolInstallRecommendations": { "type": "string" },
        "toolingFindings": { "type": "string" },
        "swarmPreflight": { "type": "string" },
        "hostDriftManifest": { "type": "string" },
        "prStackAudit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["readOnlyFirst", "noSecrets", "noServiceRestart", "noDataMutation", "defaultOutputRoot"],
      "properties": {
        "readOnlyFirst": { "const": true },
        "noSecrets": { "const": true },
        "noServiceRestart": { "const": true },
        "noDataMutation": { "const": true },
        "defaultOutputRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidenceSummary": {
      "type": "object",
      "required": ["risks", "backlogItems", "effectivityNextSafeSlices", "remainingApprovalGates", "freshSources", "staleSources", "toolPromotionCandidates", "toolActionableFindings", "toolCoverageGaps", "toolInstallRecommendations", "toolInstallApprovalRequired", "toolInstallNowCandidates", "toolingFindings", "toolingActionableFindings", "toolingIssueReadyTasks", "effectivityEvidenceLanes", "effectivityApprovalRequiredLanes", "effectivityHighSeverityLanes", "prStackStatus", "prStackOpen", "prStackMergeReady", "prStackMergeBlocked", "inFlightPrSuppressedPackets", "swarmPreflightStatus", "swarmPreflightOutsideScope", "swarmPreflightProblems", "hostDriftStatus", "hostDriftDirtyPaths", "hostDriftSensitivePathNames", "hostDriftRequiresHumanApproval", "hostDriftDoNotTouchSecurityReview", "hostDriftAllowlistStatus", "hostDriftExpiredAllowlistMatches", "staleBacklogPackets"],
      "properties": {
        "risks": { "type": "number", "minimum": 0 },
        "backlogItems": { "type": "number", "minimum": 0 },
        "effectivityNextSafeSlices": { "type": "number", "minimum": 0 },
        "remainingApprovalGates": { "type": "number", "minimum": 0 },
        "freshSources": { "type": "number", "minimum": 0 },
        "staleSources": { "type": "number", "minimum": 0 },
        "toolPromotionCandidates": { "type": ["number", "null"], "minimum": 0 },
        "toolActionableFindings": { "type": ["number", "null"], "minimum": 0 },
        "toolCoverageGaps": { "type": ["number", "null"], "minimum": 0 },
        "toolInstallRecommendations": { "type": ["number", "null"], "minimum": 0 },
        "toolInstallApprovalRequired": { "type": ["number", "null"], "minimum": 0 },
        "toolInstallNowCandidates": { "type": ["number", "null"], "minimum": 0 },
        "toolingFindings": { "type": ["number", "null"], "minimum": 0 },
        "toolingActionableFindings": { "type": ["number", "null"], "minimum": 0 },
        "toolingIssueReadyTasks": { "type": ["number", "null"], "minimum": 0 },
        "effectivityEvidenceLanes": { "type": ["number", "null"], "minimum": 0 },
        "effectivityApprovalRequiredLanes": { "type": ["number", "null"], "minimum": 0 },
        "effectivityHighSeverityLanes": { "type": ["number", "null"], "minimum": 0 },
        "prStackStatus": { "type": "string" },
        "prStackOpen": { "type": ["number", "null"], "minimum": 0 },
        "prStackMergeReady": { "type": ["number", "null"], "minimum": 0 },
        "prStackMergeBlocked": { "type": ["number", "null"], "minimum": 0 },
        "inFlightPrSuppressedPackets": { "type": "number", "minimum": 0 },
        "swarmPreflightStatus": { "type": "string" },
        "swarmPreflightOutsideScope": { "type": ["number", "null"], "minimum": 0 },
        "swarmPreflightProblems": { "type": ["number", "null"], "minimum": 0 },
        "hostDriftStatus": { "type": "string" },
        "hostDriftDirtyPaths": { "type": ["number", "null"], "minimum": 0 },
        "hostDriftSensitivePathNames": { "type": ["number", "null"], "minimum": 0 },
        "hostDriftRequiresHumanApproval": { "type": ["number", "null"], "minimum": 0 },
        "hostDriftDoNotTouchSecurityReview": { "type": ["number", "null"], "minimum": 0 },
        "hostDriftAllowlistStatus": { "type": "string" },
        "hostDriftExpiredAllowlistMatches": { "type": ["number", "null"], "minimum": 0 },
        "staleBacklogPackets": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "freshEvidence": {
      "type": "object",
      "required": ["adminAudit", "sliceLedger", "toolInventory", "toolInstallRecommendations", "toolingFindings", "swarmPreflight", "hostDriftManifest", "prStackAudit"],
      "properties": {
        "toolInstallRecommendations": {
          "type": "object",
          "required": ["source", "path", "status", "generatedAt", "summary"],
          "properties": {
            "source": { "const": "fresh-tool-install-recommendations" },
            "path": { "type": "string" },
            "status": { "type": "string" },
            "sourceStatus": { "type": "string" },
            "generatedAt": { "type": "string" },
            "summary": {
              "type": "object",
              "required": ["recommendations", "coverageGaps", "approvalRequired", "installNowCandidates", "inventoryGeneratedAt", "inventoryStatus", "topRecommendations"],
              "properties": {
                "recommendations": { "type": ["number", "null"], "minimum": 0 },
                "coverageGaps": { "type": ["number", "null"], "minimum": 0 },
                "approvalRequired": { "type": ["number", "null"], "minimum": 0 },
                "installNowCandidates": { "type": ["number", "null"], "minimum": 0 },
                "inventoryGeneratedAt": { "type": "string" },
                "inventoryStatus": { "type": "string" },
                "topRecommendations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tool", "priority", "acquisitionClass", "validationCommand", "approvalRequired"],
                    "properties": {
                      "tool": { "type": "string" },
                      "priority": { "type": "string" },
                      "acquisitionClass": { "type": "string" },
                      "validationCommand": { "type": "string" },
                      "approvalRequired": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                },
                "parseError": { "type": "string" }
              },
              "additionalProperties": false
            },
            "freshness": { "type": "object" },
            "upstreamFreshness": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "nextExecutablePacket": {
      "type": "object",
      "required": ["status", "totalPackets", "approvalGatedCount", "packetId", "title", "priority", "risk", "recommendedOwner", "safeNextStep", "suggestedBranchName", "suggestedPrTitle", "verification", "sourceSignalCount"],
      "properties": {
        "status": { "enum": ["ready", "none_ready"] },
        "totalPackets": { "type": "number", "minimum": 0 },
        "approvalGatedCount": { "type": "number", "minimum": 0 },
        "packetId": { "type": "string" },
        "title": { "type": "string" },
        "priority": { "type": "string" },
        "risk": { "type": "string" },
        "recommendedOwner": { "type": "string" },
        "safeNextStep": { "type": "string" },
        "suggestedBranchName": { "type": "string" },
        "suggestedPrTitle": { "type": "string" },
        "verification": { "type": "array", "items": { "type": "string" } },
        "sourceSignalCount": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sourceSignalAudit": {
      "type": "object",
      "required": ["status", "totalSignals", "duplicateSignalsRemoved", "missingClass", "unknownClass", "classificationCounts", "allowedClasses", "findings"],
      "properties": {
        "status": { "enum": ["pass", "warn"] },
        "totalSignals": { "type": "number", "minimum": 0 },
        "duplicateSignalsRemoved": { "type": "number", "minimum": 0 },
        "missingClass": { "type": "number", "minimum": 0 },
        "unknownClass": { "type": "number", "minimum": 0 },
        "classificationCounts": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "allowedClasses": { "type": "array", "items": { "type": "string" } },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "code", "packetId", "title", "source", "message"],
            "properties": {
              "severity": { "type": "string" },
              "code": { "type": "string" },
              "packetId": { "type": "string" },
              "title": { "type": "string" },
              "source": { "type": "string" },
              "signalClass": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inFlightPrSuppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packetId", "title", "reason", "prNumber", "prTitle", "headRefName", "url"],
        "properties": {
          "packetId": { "type": "string" },
          "title": { "type": "string" },
          "reason": { "type": "string" },
          "prNumber": { "type": "number", "minimum": 0 },
          "prTitle": { "type": "string" },
          "headRefName": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packetId", "title", "status", "priority", "risk", "recommendedOwner", "sourceSignals", "safeNextStep", "verification", "constraints"],
        "properties": {
          "packetId": { "type": "string", "pattern": "^ops-wp-" },
          "title": { "type": "string" },
          "status": { "enum": ["ready", "approval_gated"] },
          "priority": { "type": "string" },
          "priorityRank": { "type": "number" },
          "risk": { "type": "string" },
          "recommendedOwner": { "type": "string" },
          "sourceSignals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": { "type": "string" },
                "path": { "type": "string" },
                "status": { "type": "string" },
                "generatedAt": { "type": "string" },
                "signalClass": { "type": "string" },
                "summary": { "type": "object" }
              },
              "additionalProperties": true
            }
          },
          "why": { "type": "string" },
          "safeNextStep": { "type": "string" },
          "suggestedBranchName": { "type": "string" },
          "suggestedPrTitle": { "type": "string" },
          "verification": { "type": "array", "items": { "type": "string" } },
          "humanGate": { "type": "string" },
          "constraints": {
            "type": "object",
            "required": ["readOnlyFirst", "noSecrets", "noServiceRestart", "noDataMutation", "writeScope"],
            "properties": {
              "readOnlyFirst": { "const": true },
              "noSecrets": { "const": true },
              "noServiceRestart": { "const": true },
              "noDataMutation": { "const": true },
              "writeScope": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
