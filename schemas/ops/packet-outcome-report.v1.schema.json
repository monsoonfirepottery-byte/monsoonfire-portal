{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-brain.local/schemas/ops/packet-outcome-report.v1.schema.json",
  "title": "Studio Brain Ops Packet Outcome Report v1",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "runId",
    "status",
    "readOnly",
    "sources",
    "currentPacketWindow",
    "outcomeSummary",
    "outcomeHealth",
    "ledgerRetention",
    "outcomeAdoption",
    "packetChurn",
    "latestByPacket",
    "orphanedLatestOutcomes",
    "operatorNotes"
  ],
  "properties": {
    "schema": { "const": "studiobrain-ops-packet-outcome-report.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string" },
    "status": { "enum": ["pass", "warn", "fail"] },
    "readOnly": { "const": true },
    "sources": {
      "type": "object",
      "required": ["outcomes", "workPacket", "prReadiness"],
      "properties": {
        "outcomes": { "type": "string" },
        "workPacket": { "type": "string" },
        "prReadiness": { "type": "string" }
      },
      "additionalProperties": false
    },
    "currentPacketWindow": {
      "type": "object",
      "required": ["generatedAt", "packets", "packetIds", "topPackets", "readStatus", "parseError"],
      "properties": {
        "generatedAt": { "type": "string" },
        "packets": { "type": "number", "minimum": 0 },
        "packetIds": { "type": "array", "items": { "type": "string" } },
        "topPackets": { "type": "array" },
        "readStatus": { "type": "string" },
        "parseError": { "type": "string" }
      },
      "additionalProperties": false
    },
    "outcomeSummary": { "type": "object" },
    "outcomeHealth": { "type": "object" },
    "ledgerRetention": {
      "type": "object",
      "required": [
        "status",
        "exists",
        "bytes",
        "lineCount",
        "totalOutcomes",
        "uniquePackets",
        "latestOutcomePackets",
        "historicalEntries",
        "oldestRecordedAt",
        "newestRecordedAt",
        "compactionRecommended",
        "guidance"
      ],
      "properties": {
        "status": { "enum": ["pass", "warn"] },
        "exists": { "type": "boolean" },
        "bytes": { "type": ["number", "null"], "minimum": 0 },
        "lineCount": { "type": "number", "minimum": 0 },
        "totalOutcomes": { "type": "number", "minimum": 0 },
        "uniquePackets": { "type": "number", "minimum": 0 },
        "latestOutcomePackets": { "type": "number", "minimum": 0 },
        "historicalEntries": { "type": "number", "minimum": 0 },
        "oldestRecordedAt": { "type": "string" },
        "newestRecordedAt": { "type": "string" },
        "compactionRecommended": { "type": "boolean" },
        "guidance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "outcomeAdoption": {
      "type": "object",
      "required": [
        "status",
        "hasReadinessEvidence",
        "prReadinessGeneratedAt",
        "readinessPacketId",
        "readinessPacketInCurrentWindow",
        "recommendedPacketId",
        "recommendedPacketTitle",
        "currentWindowPackets",
        "totalOutcomes",
        "recordCommands",
        "guidance"
      ],
      "properties": {
        "status": { "enum": ["not_observed", "warming_up", "needs_records", "active"] },
        "hasReadinessEvidence": { "type": "boolean" },
        "prReadinessGeneratedAt": { "type": "string" },
        "readinessPacketId": { "type": "string" },
        "readinessPacketInCurrentWindow": { "type": "boolean" },
        "recommendedPacketId": { "type": "string" },
        "recommendedPacketTitle": { "type": "string" },
        "currentWindowPackets": { "type": "number", "minimum": 0 },
        "totalOutcomes": { "type": "number", "minimum": 0 },
        "recordCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["outcome", "when", "command"],
            "properties": {
              "outcome": { "enum": ["used", "helpful", "blocked", "stale", "misleading"] },
              "when": { "type": "string" },
              "command": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "guidance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "packetChurn": {
      "type": "object",
      "required": ["status", "latestOutcomePackets", "orphanedLatestOutcomes", "orphanedRate", "resetRecommended", "guidance"],
      "properties": {
        "status": { "enum": ["pass", "warn"] },
        "latestOutcomePackets": { "type": "number", "minimum": 0 },
        "orphanedLatestOutcomes": { "type": "number", "minimum": 0 },
        "orphanedRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "resetRecommended": { "type": "boolean" },
        "guidance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "latestByPacket": { "type": "array" },
    "orphanedLatestOutcomes": { "type": "array" },
    "operatorNotes": { "type": "array", "items": { "type": "string" } },
    "artifactPath": { "type": "string" },
    "markdownPath": { "type": "string" }
  },
  "additionalProperties": false
}
